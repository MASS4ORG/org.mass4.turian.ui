{
  "id": "org.mass4.turian.ui",
  "version": "2.0.0",
  "displayName": "In-game UI",
  "description": "Guinevere-based .ui documents, .pss style sheets, data binding and screen and world-space panels.",
  "author": "MASS4",
  "license": "MPL-2.0",
  "exclude": [
    "Brick~/Tests",
    ".github",
    ".gitignore",
    ".script-*.py",
    ".script-*.cs",
    ".script-*.sh"
  ],
  "dependencies": {
    "org.mass4.turian.vulkan": "builtin:org.mass4.turian.vulkan",
    "org.mass4.turian.ddd": "^1.0.0"
  },
  "nuget": {
    "MASS4.Guinevere": "6.6.0",
    "MASS4.Guinevere.Styling": "6.6.0",
    "SkiaSharp": "4.154.0",
    "SkiaSharp.NativeAssets.Linux": "4.154.0",
    "SkiaSharp.NativeAssets.macOS": "4.154.0",
    "SkiaSharp.NativeAssets.Win32": "4.154.0",
    "SkiaSharp.Views.Desktop.Common": "4.153.1",
    "SkiaSharp.Vulkan.SharpVk": "4.153.1",
    "JetBrains.Annotations": "2026.2.0"
  },
  "categories": [
    "turian:ui"
  ],
  "keywords": [
    "ui",
    "guinevere"
  ],
  "roles": {
    "source": "Brick~/Source",
    "tests": "Brick~/Tests",
    "precast": "Brick~/Precast",
    "bake": "Brick~/Bake"
  },
  "bake": "auto"
}
